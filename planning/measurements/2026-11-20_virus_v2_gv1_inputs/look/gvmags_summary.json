   "bytes": 1001,
   "head": "#!/bin/bash\n\n# Source directory containing .fna files\nSOURCE_DIR=\"/clusterfs/jgi/scratch/science/mgs/woyke_microbial/ymvasquez/GVMAGs/01fna_genomes/confirmed\"\n\n# Destination directory for chunks\nDEST_DIR=\"\"\n\n# Chunk size\nCHUNK_SIZE=20\n\n# Create destination directory\nmkdir -p \"$DEST_DIR\"\n\n# Count the number of .fna files\nfile_count=$(find \"$SOURCE_DIR\" -maxdepth 1 -type f -name \"*.fna\" | wc -l)\necho \"Total .fna files found: $file_count\"\n\n# Create chunks\ncurrent_chunk=1\ncurrent_file=1\ncurrent_chunk_dir=\"$DEST_DIR/chunk_$current_chunk\"\nmkdir -p \"$current_chunk_dir\"\n\nfor file in \"$SOURCE_DIR\"/*.fna; do\n    if [ $current_file -eq 1 ]; then\n        current_chunk_dir=\"$DEST_DIR/chunk_$current_chunk\"\n        mkdir -p \"$current_chunk_dir\"\n    fi\n\n    cp \"$file\" \"$current_chunk_dir\"\n\n    if [ $current_file -eq $CHUNK_SIZE ]; then\n        current_file=1\n        current_chunk=$((current_chunk + 1))\n    else\n        current_file=$((current_file + 1))\n    fi\ndone\n\necho \"Chunks created successfully.\"\n",
   "member": "confirmed/chunk_maker.sh~",
   "set": "gvmags_v2/all_18kgenomes_fna.tar.gz"
  }
 ],
